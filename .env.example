EZEAGENT_WORKSPACE=.
EZEAGENT_DATABASE_PATH=./ezeagent.db
EZEAGENT_CORS_ORIGINS=http://localhost:5173
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free
OPENAI_MODEL=gpt-4o-mini
COMPATIBLE_API_BASE_URL=http://127.0.0.1:1234/v1
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=local-model

# Optional local OmniRoute gateway (start it on port 20128 before using this provider)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
